    // Top properties
    if (topProperties.length) {
      lines.push("");
      lines.push("== Top Properties ==");
      lines.push("Name,Location,Bookings,Revenue,Rating");
      topProperties.forEach((p) =>
        lines.push(`"${p.name}","${p.location}",${p.bookings},${p.revenue},${p.rating ?? ""}`)
