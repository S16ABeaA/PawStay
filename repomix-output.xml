    setFormData((prev) => ({
      ...prev,
      lguPermits: prev.lguPermits.filter((_, i) => i !== index),
    }));
  };

  const handleBack = () => {
    if (currentStep > 1) setCurrentStep((prev) => prev - 1);
  };

  const handleSubmit = () => {
    toast({
      title: "Application Submitted! 🎉",
      description:
        "We'll review your property and contact you within 24-48 hours.",
    });
  };

