@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Fredoka:wght@500;600;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

/* ─── Super Admin Panel ─── */

/* Previously forced Inter across the SA panel (overrode Tailwind font utilities).
   Use `inherit` on the panel root so font utility classes (e.g. `font-display`) work. */
.sa-panel, .sa-panel * {
  font-family: inherit;
}

/* Custom dark scrollbar */
.sa-panel ::-webkit-scrollbar { width: 6px; height: 6px; }
.sa-panel ::-webkit-scrollbar-track { background: transparent; }
.sa-panel ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 3px; }
.sa-panel ::-webkit-scrollbar-thumb:hover { background: rgba(255,163,26,0.25); }
.sa-panel { scrollbar-color: rgba(255,255,255,0.08) transparent; scrollbar-width: thin; }

/* Fade-in & slide-up for page content */
@keyframes sa-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sa-slide-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@keyframes sa-scale-in { from { opacity: 0; transform: scale(0.96); } to { opacity: 1; transform: scale(1); } }

.sa-animate-in { animation: sa-fade-in 0.35s ease-out both; }
.sa-slide-in  { animation: sa-slide-up 0.4s ease-out both; }
.sa-scale-in  { animation: sa-scale-in 0.3s ease-out both; }

/* Stagger animation delays for card grids */
.sa-stagger > *:nth-child(1) { animation-delay: 0ms; }
.sa-stagger > *:nth-child(2) { animation-delay: 50ms; }
.sa-stagger > *:nth-child(3) { animation-delay: 100ms; }
.sa-stagger > *:nth-child(4) { animation-delay: 150ms; }
.sa-stagger > *:nth-child(5) { animation-delay: 200ms; }
.sa-stagger > *:nth-child(6) { animation-delay: 250ms; }
.sa-stagger > *:nth-child(7) { animation-delay: 300ms; }
.sa-stagger > *:nth-child(8) { animation-delay: 350ms; }

/* Hover-glow card used across SA pages */
.sa-card {
  transition: border-color 0.2s, box-shadow 0.2s, background-color 0.2s;
}
.sa-card:hover {
  border-color: rgba(255,163,26,0.18);
  box-shadow: 0 0 0 1px rgba(255,163,26,0.06), 0 4px 24px rgba(0,0,0,0.25);
}

/* Pulse dot animation for status indicators */
@keyframes sa-pulse-dot { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.sa-pulse-dot { animation: sa-pulse-dot 2s ease-in-out infinite; }

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* Warm, welcoming pet hotel palette */
    --background: 30 50% 98%;
    --foreground: 25 30% 15%;

    --card: 30 40% 99%;
    --card-foreground: 25 30% 15%;

    --popover: 30 40% 99%;
    --popover-foreground: 25 30% 15%;

    /* Warm coral primary */
    --primary: 16 85% 60%;
    --primary-foreground: 0 0% 100%;

    /* Soft cream secondary */
    --secondary: 35 40% 92%;
    --secondary-foreground: 25 30% 25%;

    /* Muted warm tones */
    --muted: 30 25% 93%;
    --muted-foreground: 25 15% 45%;

    /* Teal accent for CTAs */
    --accent: 174 60% 45%;
    --accent-foreground: 0 0% 100%;

    --destructive: 0 84% 60%;
    --destructive-foreground: 0 0% 100%;

    /* Warm borders */
    --border: 30 20% 88%;
    --input: 30 20% 88%;
    --ring: 16 85% 60%;

    --radius: 0.75rem;

    /* Custom tokens */
    --gradient-hero: linear-gradient(135deg, hsl(16 85% 60%) 0%, hsl(35 90% 65%) 100%);
    --gradient-card: linear-gradient(180deg, hsl(30 40% 99%) 0%, hsl(30 30% 96%) 100%);
    --gradient-accent: linear-gradient(135deg, hsl(174 60% 45%) 0%, hsl(174 70% 40%) 100%);
    
    --shadow-soft: 0 4px 20px -4px hsl(25 30% 15% / 0.08);
    --shadow-card: 0 8px 30px -8px hsl(25 30% 15% / 0.12);
    --shadow-elevated: 0 20px 50px -15px hsl(25 30% 15% / 0.18);
    --shadow-glow: 0 0 40px -10px hsl(16 85% 60% / 0.3);

    /* Rating gold */
    --rating: 45 95% 55%;
    
    /* Success green */
    --success: 145 60% 45%;
    --success-foreground: 0 0% 100%;

    --sidebar-background: 30 40% 98%;
    --sidebar-foreground: 25 30% 25%;
    --sidebar-primary: 16 85% 60%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 35 40% 92%;
    --sidebar-accent-foreground: 25 30% 25%;
    --sidebar-border: 30 20% 88%;
    --sidebar-ring: 16 85% 60%;
  }

  .dark {
    --background: 25 25% 8%;
    --foreground: 30 20% 95%;

    --card: 25 20% 12%;
    --card-foreground: 30 20% 95%;

    --popover: 25 20% 12%;
    --popover-foreground: 30 20% 95%;

    --primary: 16 80% 55%;
    --primary-foreground: 0 0% 100%;

    --secondary: 25 15% 18%;
    --secondary-foreground: 30 20% 90%;

    --muted: 25 15% 18%;
    --muted-foreground: 30 10% 60%;

    --accent: 174 55% 40%;
    --accent-foreground: 0 0% 100%;

    --destructive: 0 70% 45%;
    --destructive-foreground: 0 0% 100%;

    --border: 25 15% 20%;
    --input: 25 15% 20%;
    --ring: 16 80% 55%;

    --sidebar-background: 25 20% 10%;
    --sidebar-foreground: 30 20% 90%;
    --sidebar-primary: 16 80% 55%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 25 15% 18%;
    --sidebar-accent-foreground: 30 20% 90%;
    --sidebar-border: 25 15% 20%;
    --sidebar-ring: 16 80% 55%;
  }
}

@keyframes move-right {
  0% { left: 0; }
  50% { left: 80px; }
  100% { left: 0; }
}

.animate-move-right {
  animation: move-right 2s ease-in-out infinite;
}

.animation-delay-500 {
  animation-delay: 0.5s;
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground font-sans antialiased;
  }

  h1, h2, h3 {
    @apply font-display;
  }
}

@layer utilities {
  .text-gradient {
    @apply bg-clip-text text-transparent;
    background-image: var(--gradient-hero);
  }

  .bg-gradient-hero {
    background-image: var(--gradient-hero);
  }

  .bg-gradient-card {
    background-image: var(--gradient-card);
  }

  .bg-gradient-accent {
    background-image: var(--gradient-accent);
  }

  .shadow-soft {
    box-shadow: var(--shadow-soft);
  }

  .shadow-card {
    box-shadow: var(--shadow-card);
  }

  .shadow-elevated {
    box-shadow: var(--shadow-elevated);
  }

  .shadow-glow {
    box-shadow: var(--shadow-glow);
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-pulse-soft {
    animation: pulse-soft 3s ease-in-out infinite;
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

@keyframes pulse-soft {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

/* Help Center page animations */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ─── FullCalendar Theme Overrides ─── */
.fc {
  --fc-border-color: hsl(var(--border));
  --fc-button-bg-color: hsl(var(--primary));
  --fc-button-border-color: hsl(var(--primary));
  --fc-button-hover-bg-color: hsl(var(--primary) / 0.85);
  --fc-button-hover-border-color: hsl(var(--primary) / 0.85);
  --fc-button-active-bg-color: hsl(var(--primary) / 0.75);
  --fc-button-active-border-color: hsl(var(--primary) / 0.75);
  --fc-today-bg-color: hsl(var(--primary) / 0.06);
  --fc-page-bg-color: transparent;
  --fc-neutral-bg-color: hsl(var(--secondary));
  --fc-list-event-hover-bg-color: hsl(var(--secondary));
  --fc-now-indicator-color: hsl(var(--primary));
  font-family: inherit;
}

.fc .fc-col-header-cell-cushion,
.fc .fc-daygrid-day-number,
.fc .fc-list-day-cushion {
  color: hsl(var(--foreground));
}

.fc .fc-daygrid-day.fc-day-today {
  background-color: hsl(var(--primary) / 0.06);
}

.fc .fc-event {
  border: none;
  border-radius: 4px;
  padding: 1px 4px;
  font-size: 0.8rem;
  cursor: pointer;
}

.fc .fc-timegrid-slot {
  height: 3rem;
}

.fc .fc-scrollgrid {
  border-radius: 8px;
  overflow: hidden;
}

