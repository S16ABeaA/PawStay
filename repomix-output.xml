              Review property application
            </DialogDescription>
          </DialogHeader>
          {selectedProperty && (
            <div className="space-y-4">
              <img
                src={selectedProperty.image}
                alt={selectedProperty.name}
                className="w-full h-48 object-cover rounded-lg"
