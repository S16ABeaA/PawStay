    const files = e.target.files;
    if (files) {
      const newPermits = Array.from(files);
      setFormData((prev) => ({
        ...prev,
        lguPermits: [...prev.lguPermits, ...newPermits].slice(0, 5), // Max 5 permits
      }));
    }
  };

