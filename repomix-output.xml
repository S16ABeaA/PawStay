      // }
      
      // Clear cookies
      clearAuthCookies(res);

      return res.json({ message: "Successfully logged out." });
    } catch (err: any) {
      console.error("Logout Error:", err);
      return res.status(500).json({ error: "Internal server error." });
    }
  },
};
