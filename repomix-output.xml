    // Service breakdown
    if (serviceBreakdown.length) {
      lines.push("");
      lines.push("== Service Breakdown ==");
      lines.push("Service,Share %,Count,Revenue");
      serviceBreakdown.forEach((s) =>
        lines.push(`${s.name ?? s.type},${s.value},${s.count},${s.revenue}`)
