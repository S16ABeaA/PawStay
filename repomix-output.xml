                  <TableHead className="text-[#808080]">Property</TableHead>
                  <TableHead className="text-[#808080]">Amount</TableHead>
                  <TableHead className="text-[#808080]">Fee</TableHead>
                  <TableHead className="text-[#808080]">Status</TableHead>
