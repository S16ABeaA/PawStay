                    <Button variant="destructive" onClick={() => { handleReject(selectedProperty.id); setViewDialogOpen(false); }}>
                      Reject
                    </Button>
                  </>
                )}
                <Button variant="outline" onClick={() => setViewDialogOpen(false)} className="border-slate-600 text-slate-300">
                  Close
                </Button>
              </div>
            </div>
          )}
