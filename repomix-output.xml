CREATE TABLE public.pets (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL UNIQUE,
  name character varying NOT NULL,
  age smallint NOT NULL,
  weight numeric NOT NULL,
  type USER-DEFINED NOT NULL,
