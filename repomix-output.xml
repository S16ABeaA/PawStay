    if (bookingTrends.length) {
      lines.push("");
      lines.push("== Booking Trends ==");
      lines.push("Period,Bookings,Revenue");
      bookingTrends.forEach((t) =>
        lines.push(`${t.label ?? t.period},${t.bookings},${t.revenue}`)
